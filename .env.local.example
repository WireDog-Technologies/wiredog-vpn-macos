# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# API base URL for the WireDog backend.
# Defaults to http://localhost:3001/api in development and
# https://api.wiredogvpn.com/api in production if not set.
VITE_API_URL=http://localhost:3001/api

# Frontend URL used for account portal links (e.g. billing, password reset).
# Defaults to https://wiredogvpn.com if not set.
VITE_FRONTEND_URL=https://wiredogvpn.com

# Apple credentials — only needed when running notarized builds.
# See: scripts/build-production.sh --notarize
APPLE_ID=your-apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=YOUR_TEAM_ID
