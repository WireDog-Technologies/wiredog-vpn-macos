# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# API/frontend URLs already have team-wide defaults you don't need to set here — see
# .env.development (integration — the default for `npm run dev`) and .env.production
# (production — the default for `npm run build`/build-production.sh without --integration).
# Only uncomment these if you need something those files don't cover, e.g. pointing your
# local dev run at a backend running on localhost instead of integration:
# VITE_API_URL=http://localhost:3001/api
# VITE_FRONTEND_URL=http://localhost:3000

# Apple credentials — only needed when running notarized builds.
# See: scripts/build-production.sh --notarize
APPLE_ID=your-apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=YOUR_TEAM_ID
